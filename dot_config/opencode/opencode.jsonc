{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "lsp": true,
  "default_agent": "build",
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm *": "ask",
      "sudo *": "deny",
      "su *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fdx*": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "*": "allow"
    }
  },
  "plugin": [
    "file:///Users/ethan/dev/switchyard-opencode-bundle/plugin/tirith-guard/index.ts",
    "opencode-mem",
    "opencode-vibeguard",
    "opencode-openai-codex-auth",
    "@slkiser/opencode-quota@latest"
  ],
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
    },
    "scout": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
    },
    "explore": {
      "model": "opencode-go/mimo-v2.5",
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
