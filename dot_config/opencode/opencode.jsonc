{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "lsp": true,
  "default_agent": "build",
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm *": "ask",
      "sudo *": "deny",
      "su *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fdx*": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "*": "allow"
    }
  },
  "plugin": [
    "file:///Users/ethan/dev/switchyard-opencode-bundle/plugin/tirith-guard/index.ts",
    "opencode-mem",
    "opencode-vibeguard"
  ],
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "high",
    },
    "plan": {
      "model": "opencode-go/glm-5.3-flash",
      "variant": "max",
      "temperature": 1,
      "top_p": 0.95
    },
    "scout": {
      "model": "opencode-go/mimo-v2.5",
    }
  },
  "provider": {
    "switchyard": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Switchyard",
      "options": {
        "baseURL": "https://switchyard.ts.grouchy.cc/v1"
      },
      "models": {
        "build": {
          "name": "Deepseek v4.1 Flash (high)",
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "plan": {
          "name": "GLM 5.3 Flash (max)",
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "scout": {
          "name": "Mimo v2.5",
          "tool_call": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
