# vim: set ft=bash :

shopt -s autocd

source ~/.variables.sh
source ~/.aliases.sh
source ~/.prompt.sh

[ -f ~/.bashrc-local ] && source ~/.bashrc-local
[ -f ~/.fzf.bash ] && source ~/.fzf.bash

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

alias ref='source ~/.bashrc && echo reloaded bashrc'
alias href='exec $SHELL'
