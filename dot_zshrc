# vim: set ft=zsh :

autoload -Uz compinit
compinit
bindkey -e
disable r
setopt AUTO_CD

source ~/.variables.sh
source ~/.aliases.sh
source ~/.prompt.sh

[ -f ~/.zshrc-local ] && source ~/.zshrc-local
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

alias ref='source ~/.zshrc && echo reloaded shell'
alias href='exec $SHELL'
